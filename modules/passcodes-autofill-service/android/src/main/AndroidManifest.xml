<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name="com.jeeldobariya.passcodes.autofill.AutofillSettingsActivity"
            android:theme="@style/Theme.PasscodesAutofill"
            android:exported="true" />

        <!-- Host for the biometric "tap to unlock" step. Not exported:
             it's only ever launched via the PendingIntent this app
             creates itself in Dataset.Builder#setAuthentication. -->
        <activity
            android:name="com.jeeldobariya.passcodes.autofill.AutofillUnlockActivity"
            android:theme="@style/Theme.PasscodesAutofill.Unlock"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance" />

        <service
            android:name=".PasscodesAutofillService"
            android:exported="true"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>

            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service" />
        </service>
    </application>
</manifest>
