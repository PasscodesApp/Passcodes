<?xml version="1.0" encoding="utf-8"?>

<!-- Autofill dropdown row. Inflated inside the system's process through
     RemoteViews, so: only RemoteViews-safe widgets, and explicit colour
     resources (which have night variants) instead of ?attr/ theme
     lookups, which are not reliably resolved there. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/autofill_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/autofill_item_background"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="10dp">

    <!-- Icon badge: key (ready to fill) or lock (needs unlocking) -->
    <ImageView
        android:id="@+id/autofill_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/autofill_icon_badge"
        android:contentDescription="@null"
        android:padding="10dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_autofill_key"
        android:tint="@color/md_on_primary_container" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Site / app name -->
        <TextView
            android:id="@+id/autofill_domain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/md_on_surface"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Username, or "Tap to unlock" when the lock is on -->
        <TextView
            android:id="@+id/autofill_username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/md_on_surface_variant"
            android:textSize="14sp" />

    </LinearLayout>

</LinearLayout>
