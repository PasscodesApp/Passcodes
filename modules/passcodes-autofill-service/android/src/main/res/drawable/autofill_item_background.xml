<?xml version="1.0" encoding="utf-8"?>

<!-- Dropdown row card: tonal surface with a hairline outline so it reads
     on both light and dark system dropdown backgrounds. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@color/md_surface_container_high" />
    <stroke
        android:width="1dp"
        android:color="@color/md_outline_variant" />
    <corners android:radius="16dp" />

</shape>
