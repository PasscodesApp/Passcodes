{
  "name": "passcodes",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "build": "bash scripts/build-all-cloud.sh",
    "build:develop": "eas build --profile development --platform android --local",
    "build:preview": "eas build --profile preview --platform android --local",
    "db:generate": "drizzle-kit generate --name",
    "deploy": "eas build --profile deploy --platform android --local",
    "deploy:arm64": "eas build --profile deploy-arm64 --platform android --local",
    "deploy:armv7": "eas build --profile deploy-armv7 --platform android --local",
    "deploy:x86": "eas build --profile deploy-x86 --platform android --local",
    "deploy:x86_64": "eas build --profile deploy-x86_64 --platform android --local"
  },
  "dependencies": {
    "@passcodes/passalgo": "git+https://github.com/PasscodesApp/PassAlgo.git#v1.0.0",
    "@react-native-community/slider": "5.2.1",
    "@react-native-documents/picker": "^12.0.2",
    "@react-native-vector-icons/fontawesome6": "^13.1.5",
    "@shopify/flash-list": "2.3.2",
    "babel-plugin-inline-import": "^3.0.0",
    "drizzle-orm": "^0.45.4",
    "expo": "^58.0.0",
    "expo-build-properties": "~58.0.11",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.14",
    "expo-file-system": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-local-authentication": "~58.0.2",
    "expo-navigation-bar": "~58.0.4",
    "expo-router": "~58.0.25",
    "expo-screen-capture": "~58.0.6",
    "expo-screen-orientation": "~58.0.3",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "papaparse": "^5.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-paper": "^5.15.3",
    "react-native-quick-crypto": "^1.1.8",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/papaparse": "^5.5.2",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "expo-doctor": "^1.21.5",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3"
  },
  "private": true,
  "allowScripts": {
    "github:PasscodesApp/PassAlgo": true
  }
}
